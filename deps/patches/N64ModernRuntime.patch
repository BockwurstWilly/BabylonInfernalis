+++ b/ultramodern/include/ultramodern/tlb_mappings.hpp
@@ -0,0 +1,28 @@
+#ifndef __ULTRAMODERN_TLB_MAPPINGS_HPP__
+#define __ULTRAMODERN_TLB_MAPPINGS_HPP__
+
+#include <cstdint>
+
+// Fixed TLB mappings of the game, emulated by mapping the same memory at several addresses (Indy64 addition).
+//
+// Indiana Jones and the Infernal Machine runs with a TLB entry that maps virtual 0x40000000-0x407FFFFF onto
+// RDRAM, and keeps a second code/data segment at virtual 0x41000000 (demand-paged from ROM on the N64). librecomp
+// maps these ranges as additional views of the RDRAM allocation, so 0x40xxxxxx, 0x80xxxxxx and the physical
+// address used by RSP/RDP/DMA all reach the same bytes. osVirtualToPhysical uses the same table.
+namespace ultramodern {
+    struct TlbMapping {
+        uint32_t virtual_address;
+        uint32_t physical_address;
+        uint32_t size;
+    };
+
+    inline constexpr TlbMapping tlb_mappings[] = {
+        // All 16 MiB of (extended) RDRAM, the game's own TLB entry 0 covers the first 8 MiB.
+        { 0x40000000u, 0x00000000u, 0x01000000u },
+        // Second segment ("VM window", ROM 0x4DC30, 0xBE620 bytes). Placed in an unused part of extended RDRAM,
+        // between librecomp's handles/patch data (0x80800000+) and the mod/heap area (0x81000000+).
+        { 0x41000000u, 0x00C00000u, 0x00100000u },
+    };
+}
+
+#endif
