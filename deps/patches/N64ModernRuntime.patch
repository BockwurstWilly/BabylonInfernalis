+#ifdef _WIN32
+// RDRAM as a pagefile-backed section, mapped once for kseg0 (offset 0) and again for every fixed TLB mapping in
+// ultramodern::tlb_mappings, so all those addresses reach the same memory (Indy64 addition). Uses the placeholder
+// APIs of Windows 10 1803+, loaded dynamically so no newer import library is needed.
+#ifndef MEM_RESERVE_PLACEHOLDER
+#define MEM_RESERVE_PLACEHOLDER 0x00040000
+#endif
+#ifndef MEM_REPLACE_PLACEHOLDER
+#define MEM_REPLACE_PLACEHOLDER 0x00004000
+#endif
+#ifndef MEM_PRESERVE_PLACEHOLDER
+#define MEM_PRESERVE_PLACEHOLDER 0x00000002
+#endif
+
+namespace {
+    using VirtualAlloc2_t = PVOID(WINAPI*)(HANDLE, PVOID, SIZE_T, ULONG, ULONG, void*, ULONG);
+    using MapViewOfFile3_t = PVOID(WINAPI*)(HANDLE, HANDLE, PVOID, ULONG64, SIZE_T, ULONG, ULONG, void*, ULONG);
+
+    struct RdramMapping {
+        HANDLE section = nullptr;
+        std::vector<void*> views;
+        std::vector<void*> placeholders;
+    };
+
+    RdramMapping rdram_mapping;
+
+    // Offset of a 32-bit address inside the rdram allocation (MEM_* use rdram + addr - 0x80000000).
+    constexpr size_t rdram_offset(uint32_t address) {
+        return size_t(uint32_t(address - 0x80000000u));
+    }
+
+    uint8_t* allocate_rdram_mapped() {
+        HMODULE kernelbase = GetModuleHandleW(L"kernelbase.dll");
+        auto virtual_alloc2 = reinterpret_cast<VirtualAlloc2_t>(GetProcAddress(kernelbase, "VirtualAlloc2"));
+        auto map_view_of_file3 = reinterpret_cast<MapViewOfFile3_t>(GetProcAddress(kernelbase, "MapViewOfFile3"));
+        if (virtual_alloc2 == nullptr || map_view_of_file3 == nullptr) {
+            fprintf(stderr, "VirtualAlloc2/MapViewOfFile3 are not available (Windows 10 1803 or newer is required)\n");
+            return nullptr;
+        }
+
+        uint8_t* base = reinterpret_cast<uint8_t*>(virtual_alloc2(nullptr, nullptr, recomp::allocation_size,
+            MEM_RESERVE | MEM_RESERVE_PLACEHOLDER, PAGE_NOACCESS, nullptr, 0));
+        if (base == nullptr) {
+            return nullptr;
+        }
+
+        // The views: kseg0 RDRAM, then every TLB mapping (offset in the allocation, offset in the section, size).
+        struct View { size_t offset; size_t section_offset; size_t size; };
+        std::vector<View> views{ { 0, 0, recomp::mem_size } };
+        for (const ultramodern::TlbMapping& mapping : ultramodern::tlb_mappings) {
+            views.push_back({ rdram_offset(mapping.virtual_address), mapping.physical_address, mapping.size });
+        }
+
+        std::sort(views.begin(), views.end(), [](const View& a, const View& b) { return a.offset < b.offset; });
+
+        // Split the placeholder so each view gets one of its own; the gaps stay reserved and inaccessible.
+        size_t cursor = 0;
+        for (const View& view : views) {
+            if (view.offset < cursor || view.offset + view.size > recomp::allocation_size) {
+                fprintf(stderr, "Overlapping or out of range rdram view at offset 0x%zX\n", view.offset);
+                VirtualFree(base, 0, MEM_RELEASE);
+                return nullptr;
+            }
+            if (view.offset > cursor) {
+                rdram_mapping.placeholders.push_back(base + cursor);
+            }
+            if (view.offset + view.size < recomp::allocation_size &&
+                !VirtualFree(base + view.offset, view.size, MEM_RELEASE | MEM_PRESERVE_PLACEHOLDER)) {
+                fprintf(stderr, "Failed to split rdram placeholder (error %lu)\n", GetLastError());
+                return nullptr;
+            }
+            cursor = view.offset + view.size;
+        }
+        if (cursor < recomp::allocation_size) {
+            rdram_mapping.placeholders.push_back(base + cursor);
+        }
+
+        const ULARGE_INTEGER section_size{ .QuadPart = recomp::mem_size };
+        rdram_mapping.section = CreateFileMappingW(INVALID_HANDLE_VALUE, nullptr, PAGE_READWRITE,
+            section_size.HighPart, section_size.LowPart, nullptr);
+        if (rdram_mapping.section == nullptr) {
+            fprintf(stderr, "Failed to create the rdram section (error %lu)\n", GetLastError());
+            return nullptr;
+        }
+
+        for (const View& view : views) {
+            void* mapped = map_view_of_file3(rdram_mapping.section, GetCurrentProcess(), base + view.offset,
+                view.section_offset, view.size, MEM_REPLACE_PLACEHOLDER, PAGE_READWRITE, nullptr, 0);
+            if (mapped == nullptr) {
+                fprintf(stderr, "Failed to map rdram view at offset 0x%zX (error %lu)\n", view.offset, GetLastError());
+                return nullptr;
+            }
+            rdram_mapping.views.push_back(mapped);
+        }
+
+        return base;
+    }
+
+    [[maybe_unused]] bool free_rdram_mapped() {
+        bool ok = true;
+        for (void* view : rdram_mapping.views) {
+            ok &= (UnmapViewOfFile(view) != 0);
+        }
+        for (void* placeholder : rdram_mapping.placeholders) {
+            ok &= (VirtualFree(placeholder, 0, MEM_RELEASE) != 0);
+        }
+        if (rdram_mapping.section != nullptr) {
+            CloseHandle(rdram_mapping.section);
+        }
+        rdram_mapping = {};
+        return ok;
+    }
+}
