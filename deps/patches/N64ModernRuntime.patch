+void indy64_log_rsp_read(uint32_t dram_addr, uint32_t len) {
+    static uint32_t range_start = 0, range_end = 0;
+    static bool parsed = false;
+    if (!parsed) {
+        parsed = true;
+        if (const char* range = getenv("INDY64_RSP_DMA_RANGE")) {
+            char* comma = nullptr;
+            range_start = uint32_t(strtoul(range, &comma, 16));
+            range_end = (comma && *comma == ',') ? uint32_t(strtoul(comma + 1, nullptr, 16)) : range_start;
+        }
+    }
+    const uint32_t phys = dram_addr & 0xFFFFF8;
+    if ((range_end != 0) && (phys >= range_start) && (phys < range_end)) {
+        static uint32_t count = 0;
+        if (count++ < 2000) {
+            fprintf(stderr, "[rsp-read] %08X len %X\n", dram_addr, len + 1);
+        }
+    }
+}
+
+void indy64_log_rsp_write(uint32_t dmem_addr, uint32_t dram_addr, uint32_t len) {
+    static const bool enabled = getenv("INDY64_RSP_WRITE_LOG") != nullptr;
+    static uint32_t count = 0;
+    if (enabled && (count++ < 400)) {
+        fprintf(stderr, "[rsp-write] dmem %03X -> %08X len %X\n", dmem_addr, dram_addr, len + 1);
+    }
+}
+
+void indy64_capture_rsp_write(uint8_t* rdram, uint32_t dram_addr, uint32_t len) {
+    static FILE* f = getenv("INDY64_MIX_CAPTURE") ? fopen(getenv("INDY64_MIX_CAPTURE"), "wb") : nullptr;
+    if ((f == nullptr) || (len != 0x480)) {
+        return;
+    }
+    uint8_t bytes[0x480];
+    for (uint32_t i = 0; i < len; i++) {
+        bytes[i] = MEM_B(0, (int64_t)(int32_t)(dram_addr + i + 0x80000000));
+    }
+    fwrite(bytes, 1, len, f);
+    fflush(f);
+}
+
