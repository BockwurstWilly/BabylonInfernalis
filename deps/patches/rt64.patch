+            auto drawTri = [&](uint32_t a, uint32_t b, uint32_t c) {
+                // Indy64 bug reports: every triangle of the dumped list with its corners in clip space (x y z w),
+                // whether it is dropped and the scissor it is drawn with.
+                if (displayListDumpFile != nullptr) {
+                    const Workload &workload = currentWorkload(state);
+                    const FixedRect &sc = state->rdp->scissorRectStack[state->rdp->scissorStackSize - 1];
+                    fprintf(displayListDumpFile, "  tri %s tex %d scissor %d %d %d %d geom %08X:", isVisible(a, b, c) ? "drawn" : "DROPPED", int(useTex),
+                        sc.ulx / 4, sc.uly / 4, sc.lrx / 4, sc.lry / 4, rsp.geometryModeStack[rsp.geometryModeStackSize - 1]);
+                    for (uint32_t slot : { a, b, c }) {
+                        const auto &tf = workload.drawData.posTransformed[rsp.indices[slot]];
+                        fprintf(displayListDumpFile, " [%.1f %.1f %.1f %.1f]", float(tf.x), float(tf.y), float(tf.z), float(tf.w));
+                    }
+                    fprintf(displayListDumpFile, "\n");
+                }
+
+                if (!isVisible(a, b, c)) {
+                    static uint32_t clippedPrints = 0;
+                    if ((traceClipped == 0) && ((traceLists % 300) == 0) && (clippedPrints++ < 24)) {
+                        const Workload &workload = currentWorkload(state);
+                        const auto &mvp = rsp.modelViewProjMatrix;
+                        fprintf(stderr, "[f5indi] clipped tri, mvp rows:\n");
+                        for (int r = 0; r < 4; r++) {
+                            fprintf(stderr, "    %g %g %g %g\n", float(mvp[r][0]), float(mvp[r][1]), float(mvp[r][2]), float(mvp[r][3]));
+                        }
+                        for (uint32_t slot : { a, b, c }) {
+                            const uint32_t g = rsp.indices[slot];
+                            const auto &tf = workload.drawData.posTransformed[g];
+                            fprintf(stderr, "    v%u pos %g %g %g -> %g %g %g %g\n", slot, workload.drawData.posFloats[g * 3 + 0],
+                                workload.drawData.posFloats[g * 3 + 1], workload.drawData.posFloats[g * 3 + 2],
+                                float(tf.x), float(tf.y), float(tf.z), float(tf.w));
+                        }
+                    }
+                    traceClipped++;
+                    return;
+                }
+
+                // Untextured polygons are never culled; textured ones never cull front faces only.
+                uint32_t &geometryMode = rsp.geometryModeStack[rsp.geometryModeStackSize - 1];
+                const uint32_t savedMode = geometryMode;
+                if (useTex) {
+                    if ((geometryMode & rsp.cullBothMask) == rsp.cullBothMask) {
+                        geometryMode &= ~rsp.cullFrontMask;
+                    }
+                }
+                else {
+                    geometryMode &= ~rsp.cullBothMask;
+                }                if (geometryMode != savedMode) {
+                    state->updateDrawStatusAttribute(DrawAttribute::GeometryMode);
+                }
+
+                // Bring-up aid: triangles with a corner behind the camera (w <= 0) or far outside the screen.
+                {
+                    static uint32_t oddPrints = 0;
+                    const Workload &workload = currentWorkload(state);
+                    bool odd = false;
+                    float minX = 1e9f, maxX = -1e9f, minY = 1e9f, maxY = -1e9f;
+                    for (uint32_t slot : { a, b, c }) {
+                        const auto &tf = workload.drawData.posTransformed[rsp.indices[slot]];
+                        odd |= (float(tf.w) <= 0.0f) || (std::abs(float(tf.x)) > 8.0f * std::abs(float(tf.w))) || (std::abs(float(tf.y)) > 8.0f * std::abs(float(tf.w)));
+                        if (float(tf.w) > 0.0f) {
+                            const float nx = float(tf.x) / float(tf.w), ny = float(tf.y) / float(tf.w);
+                            minX = std::min(minX, nx); maxX = std::max(maxX, nx);
+                            minY = std::min(minY, ny); maxY = std::max(maxY, ny);
+                        }
+                    }
+                    // Also report triangles covering more than half the screen in either direction.
+                    odd |= ((maxX - minX) > 1.0f) || ((maxY - minY) > 1.0f);
+                    static const uint32_t oddFrom = getenv("INDY64_ODD_FROM") ? uint32_t(atoi(getenv("INDY64_ODD_FROM"))) : 0;
+                    if (odd && (traceLists == oddFrom) && (oddPrints++ < 400)) {
+                        fprintf(stderr, "[f5indi] odd tri list %u at %08X op %02X w0 %08X w1 %08X:", traceLists, uint32_t(reinterpret_cast<const uint8_t *>(*dl) - state->RDRAM), w0 >> 24, w0, w1);
+                        for (uint32_t slot : { a, b, c }) {
+                            const uint32_t g = rsp.indices[slot];
+                            const auto &tf = workload.drawData.posTransformed[g];
+                            fprintf(stderr, " [slot %u pos %g %g %g -> %g %g %g w %g]", slot, workload.drawData.posFloats[g * 3 + 0],
+                                workload.drawData.posFloats[g * 3 + 1], workload.drawData.posFloats[g * 3 + 2], float(tf.x), float(tf.y), float(tf.z), float(tf.w));
+                        }
+                        fprintf(stderr, "\n");
+                    }
+                }
+
+                static uint32_t drawnPrints = 0;
+                if (((traceLists % 300) == 0) && (traceTris < 400) && ((traceTris % 40) == 0) && (drawnPrints++ < 200)) {
+                    const Workload &workload = currentWorkload(state);
+                    fprintf(stderr, "[f5indi] drawn tri list %u #%u geom %08X othermode %08X %08X tex %d:", traceLists, traceTris,
+                        geometryMode, state->rdp->otherMode.H, state->rdp->otherMode.L, int(useTex));
+                    for (uint32_t slot : { a, b, c }) {
+                        const auto &tf = workload.drawData.posTransformed[rsp.indices[slot]];
+                        const auto &ps = workload.drawData.posScreen[rsp.indices[slot]];
+                        fprintf(stderr, " (%.0f %.0f %.3f w%.0f | scr %.1f %.1f %.3f | proj %u)", float(tf.x / tf.w * 100.0f), float(tf.y / tf.w * 100.0f), float(tf.z / tf.w), float(tf.w),
+                            float(ps.x), float(ps.y), float(ps.z), uint32_t(workload.drawData.viewProjIndices[rsp.indices[slot]]));
+                    }
+                    fprintf(stderr, " scissor %d %d %d %d", int(state->rdp->scissorRectStack[state->rdp->scissorStackSize - 1].ulx), int(state->rdp->scissorRectStack[state->rdp->scissorStackSize - 1].uly),
+                        int(state->rdp->scissorRectStack[state->rdp->scissorStackSize - 1].lrx), int(state->rdp->scissorRectStack[state->rdp->scissorStackSize - 1].lry));
+                    fprintf(stderr, "\n");
+                }
+                rsp.drawIndexedTri(a, b, c);
+                if (geometryMode != savedMode) {
+                    geometryMode = savedMode;
+                    state->updateDrawStatusAttribute(DrawAttribute::GeometryMode);
+                }
+            };
+
+            traceTris += tri2 ? 2 : 1;
+            drawTri(vert[0], vert[1], vert[2]);
+            if (tri2) {
+                drawTri(vert[0], vert[2], vert[3]);
+            }
+
+            // 16 bytes without texture coordinates, 32 with.
+            *dl = *dl + (useTex ? 3 : 1);
+        }
