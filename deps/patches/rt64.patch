+        // Same rule as GLideN64's isClipped: the triangle is dropped if all corners are outside the same plane.
+        static uint32_t clipFlags(const hlslpp::float4 &p) {
+            const float x = p.x, y = p.y, w = p.w;
+            uint32_t flags = 0;
+            flags |= (x < -w) ? 0x1 : 0;
+            flags |= (x > w) ? 0x2 : 0;
+            flags |= (y < -w) ? 0x4 : 0;
+            flags |= (y > w) ? 0x8 : 0;
+            flags |= (w < 0.01f) ? 0x10 : 0;
+            return flags;
+        }
+
+        static uint32_t vertexClipFlags(State *state, uint32_t slot) {
+            const Workload &workload = currentWorkload(state);
+            return clipFlags(workload.drawData.posTransformed[state->rsp->indices[slot]]);
+        }
+
+        static void tri(State *state, DisplayList **dl) {
+            RSP &rsp = *state->rsp;
+            const uint32_t *p = params(*dl);
+            const uint32_t w0 = p[0];
+            const uint32_t w1 = p[1];
+            const bool tri2 = (w0 >> 24) == F5INDI_TRI2;
+            const uint32_t w2 = p[2];
+            const uint32_t w3 = p[3];
+            const uint32_t vert[4] = {
+                (shiftR(w1, 16, 12) - 0x600) / 40,
+                (shiftR(w1, 0, 12) - 0x600) / 40,
+                (shiftR(w3, 16, 12) - 0x600) / 40,
+                (shiftR(w3, 0, 12) - 0x600) / 40
+            };
+
+            const uint32_t colorOffsets[4] = { shiftR(w2, 16, 8), shiftR(w2, 8, 8), shiftR(w2, 0, 8), shiftR(w2, 24, 8) };
+            const bool useTex = (w0 & 0x0200) != 0;
+            uint32_t computedST[4];
+            const uint32_t *texBase = p + 4;
+            const uint32_t count = tri2 ? 4 : 3;
+            if ((w0 & 0x0800) != 0) {
+                calcST(p, computedST, count);
+                texBase = computedST;
+            }
+
+            for (uint32_t i = 0; i < count; i++) {
+                if (vert[i] >= RSP_MAX_VERTICES) {
+                    assert(false && "F5INDI triangle uses an invalid vertex slot.");
+                    return;
+                }
+            }
+
+            // GLideN64 buffers the triangles and runs the material sub display list right after the first visible one,
+            // so the material already applies to it. RT64 draws immediately, so the sub list has to run first.
+            auto isVisible = [&](uint32_t a, uint32_t b, uint32_t c) {
+                return (vertexClipFlags(state, a) & vertexClipFlags(state, b) & vertexClipFlags(state, c)) == 0;
+            };
+
+            if (isVisible(vert[0], vert[1], vert[2]) || (tri2 && isVisible(vert[0], vert[2], vert[3]))) {
+                doSubDList(state);
+            }
+
+            // Bring-up aid: INDY64_FLAT draws all triangles with the shade color only (combiner 0,0,0,SHADE / 1).
+            static const bool flat = getenv("INDY64_FLAT") != nullptr;
+            if (flat) {
+                state->rdp->setCombine((uint64_t(0xFFFFFF) << 32) | 0xFFFE7D3EULL);
+            }
+
+            // Colors and texture coordinates belong to the triangle corner, not to the vertex.
+            const bool persp = state->rdp->otherMode.textPersp() != 0;
+            static const bool whiteShade = getenv("INDY64_WHITE_SHADE") != nullptr;
+            for (uint32_t i = 0; i < count; i++) {
+                rsp.modifyVertex(uint16_t(vert[i]), G_MWO_POINT_RGBA, whiteShade ? 0xFFFFFFFFU : *F5_DMEM(const uint32_t *, 0xD40 + colorOffsets[i]));
