diff --git b/src/gbi/rt64_gbi_f5indi.cpp b/src/gbi/rt64_gbi_f5indi.cpp
new file mode 100644
index 0000000..97dd0d0
--- /dev/null
+++ b/src/gbi/rt64_gbi_f5indi.cpp
@@ -0,0 +1,1600 @@
+//
+// RT64
+//
+// Factor 5 microcode of "Indiana Jones and the Infernal Machine" (also used by "Star Wars Episode I: Battle for
+// Naboo"). Port of GLideN64's src/uCodes/F5Indi_Naboo.cpp at commit a04081ad6a966a9413bea63a55f502e0dc98bb18.
+// Microcode decoding: olivieryuyu. GLideN64 is licensed under the GPL-2.0, so this file is too.
+//
+// Only the paths used by Indiana Jones are ported; the Naboo-only commands (geometry gen modes 0x09, 0x0C, 0x0F,
+// 0x15, 0x4F and command 0xBE) are left out.
+//
+// How the microcode works, compared to F3D:
+// - The microcode keeps a lot of state in its DMEM (lights, colors, texture coordinate matrices, the sub display
+//   list address, ...) and the commands read and write it directly. This port keeps a 4 KiB DMEM image in the same
+//   layout as GLideN64 (32-bit words in host order, so byte accesses use ^3 and halfword accesses ^1), which lets
+//   the DMEM arithmetic be ported line by line.
+// - Positions are loaded into vertex slots without color or texture coordinates. Each triangle command carries the
+//   colors (as offsets into the lit color buffer at DMEM 0xD40) and the texture coordinates for its corners, which
+//   are applied with RSP::modifyVertex; it copies a vertex that was already used by an earlier triangle.
+// - Display lists are built from chained blocks: every list starts with an 8-byte header whose first word points to
+//   the next block, and JUMPDL (0xB5) continues there. The current "next block" pointer is kept per nesting level.
+// - Some commands are longer than 8 bytes (TRI1/TRI2, TEXRECT, the geometry generators) and advance the display
+//   list themselves, as GLideN64 does with RSP.PC.
+
+#include "rt64_gbi_f5indi.h"
+
+#include <algorithm>
+#include <array>
+#include <cassert>
+#include <cmath>
+#include <cstring>
+#include <ctime>
+#include <vector>
+
+#include "common/rt64_common.h"
+#include "hle/rt64_interpreter.h"
+#include "hle/rt64_workload_queue.h"
+
+#include "rt64_f3d.h"
+#include "rt64_gbi_rdp.h"
+
+namespace RT64 {
+    // Bring-up aid from rt64_interpreter.cpp (INDY64_DUMP_DL).
+    extern FILE *displayListDumpFile;
+
+    namespace GBI_F5INDI {
+        enum : uint8_t {
+            F5INDI_SPNOOP = 0x00,
+            F5INDI_MOVEMEM = 0x01,
+            F5INDI_SET_DLIST_ADDR = 0x02,
+            F5INDI_GEOMETRY_GEN = 0x05,
+            F5INDI_DL = 0x06,
+            F5INDI_BRANCHDL = 0x07,
+            F5INDI_TRI2 = 0xB4,
+            F5INDI_JUMPDL = 0xB5,
+            F5INDI_CLEARGEOMETRYMODE = 0xB6,
+            F5INDI_SETGEOMETRYMODE = 0xB7,
+            F5INDI_ENDDL = 0xB8,
+            F5INDI_SETOTHERMODE_C = 0xB9,
+            F5INDI_SETOTHERMODE = 0xBA,
+            F5INDI_TEXTURE = 0xBB,
+            F5INDI_MOVEWORD = 0xBC,
+            F5INDI_TRI1 = 0xBF,
+            F5INDI_TEXRECT = 0xE4
+        };
+
+        // Matches the first 8 bytes of RSP::Vertex (and GLideN64's SWVertex).
+        struct SWVertex {
+            int16_t y;
+            int16_t x;
+            uint16_t flag;
+            int16_t z;
+        };
+
+        constexpr uint32_t MaxDisplayListDepth = 32;
+
+        struct Context {
+            // 0x100 bytes of slack, the microcode code paths are not bounds-checked in GLideN64 either.
+            alignas(8) std::array<uint8_t, 0x1100> dmem;
+            std::array<uint32_t, MaxDisplayListDepth> nextBlock; // GLideN64: RSP.F5DL
+            uint32_t depth = 0;
+            int32_t mtxStAdjust[16];
+            hlslpp::float4x4 mtxVtxGen;
+            std::vector<SWVertex> vertexScratch;
+        };
+
+        static Context ctx;
+
+#       define F5_DMEM(type, addr) reinterpret_cast<type>(ctx.dmem.data() + (addr))
+#       define F5_RDRAM(type, addr) reinterpret_cast<type>(state->RDRAM + (addr))
+
+        static inline uint32_t shiftR(uint32_t v, uint32_t s, uint32_t w) {
+            return (v >> s) & ((w >= 32) ? 0xFFFFFFFFU : ((1U << w) - 1U));
+        }
+
+        static inline uint32_t shiftL(uint32_t v, uint32_t s, uint32_t w) {
+            return (v & ((w >= 32) ? 0xFFFFFFFFU : ((1U << w) - 1U))) << s;
+        }
+
+        // X*X + Y*Y + Z*Z of 16-bit values. GLideN64 computes this in 32-bit int, where it wraps on overflow;
+        // this keeps the same result without relying on signed overflow.
+        static inline uint64_t squaredLength(int16_t X, int16_t Y, int16_t Z) {
+            const uint32_t sum = uint32_t(int32_t(X) * X) + uint32_t(int32_t(Y) * Y) + uint32_t(int32_t(Z) * Z);
+            return uint64_t(int64_t(int32_t(sum)));
+        }
+
+        static inline const uint32_t *params(DisplayList *dl) {
+            return reinterpret_cast<const uint32_t *>(dl);
+        }
+
+        static Workload &currentWorkload(State *state) {
+            return state->ext.workloadQueue->workloads[state->ext.workloadQueue->writeCursor];
+        }
+
+        // Display list control flow.
+
+        static void enterList(State *state, DisplayList **dl, uint32_t address) {
+            address &= 0xFFFFFF;
+            // Point at the block header; the interpreter's increment skips it.
+            *dl = reinterpret_cast<DisplayList *>(state->fromRDRAM(address));
+            ctx.nextBlock[ctx.depth] = shiftR(*F5_RDRAM(const uint32_t *, address), 0, 24);
+        }
+
+        // Bring-up statistics, printed for the first display lists.
+        static uint32_t traceLists = 0;
+        static uint32_t traceTris = 0;
+        static uint32_t traceRects = 0;
+        static uint32_t traceClipped = 0;
+
+        static void traceListEnd() {
+            if (traceLists > 0 && (traceLists <= 20 || (traceLists % 300) == 0)) {
+                fprintf(stderr, "[f5indi] list %u: %u triangles (%u clipped), %u texrects\n", traceLists, traceTris, traceClipped, traceRects);
+            }
+        }
+
+        static void startDisplayList(State *state, DisplayList **dl) {
+            traceListEnd();
+            traceLists++;
+            traceTris = 0;
+            traceRects = 0;
+            traceClipped = 0;
+            if (traceLists <= 3) {
+                const uint32_t *w = reinterpret_cast<const uint32_t *>(*dl);
+                fprintf(stderr, "[f5indi] list start: %08X %08X %08X %08X %08X %08X\n", w[0], w[1], w[2], w[3], w[4], w[5]);
+            }
+
+            // GLideN64: _ProcessDListFactor5. The root list also starts with a block header.
+            static const uint32_t addrToClear[] = { 0x11C, 0x120, 0x124, 0x37C, 0x58C, 0x5B0, 0x5B4 };
+            for (uint32_t addr : addrToClear) {
+                *F5_DMEM(uint32_t *, addr) = 0;
+            }
+
+            ctx.depth = 0;
+            ctx.nextBlock[0] = (*dl)->w0 & 0xFFFFFF;
+            *dl = *dl + 1;
+        }
+
+        static void runDl(State *state, DisplayList **dl) {
+            if (ctx.depth + 1 >= MaxDisplayListDepth) {
+                assert(false && "F5INDI display list stack overflow.");
+                return;
+            }
+
+            state->pushReturnAddress(*dl);
+            ctx.depth++;
+            enterList(state, dl, (*dl)->w1);
+        }
+
+        static void branchDl(State *state, DisplayList **dl) {
+            enterList(state, dl, (*dl)->w1);
+        }
+
+        static void jumpDl(State *state, DisplayList **dl) {
+            enterList(state, dl, ctx.nextBlock[ctx.depth]);
+        }
+
+        static void endDl(State *state, DisplayList **dl) {
+            if (ctx.depth > 0) {
+                ctx.depth--;
+            }
+
+            *dl = state->popReturnAddress();
+        }
+
+        // Runs the display list whose address the game stored at DMEM 0x58C (GLideN64: F5INDI_DoSubDList).
+        static void doSubDList(State *state) {
+            const uint32_t dlistAddr = shiftR(*F5_DMEM(const uint32_t *, 0x58C), 0, 24);
+            if (dlistAddr == 0) {
+                return;
+            }
+
+            if (ctx.depth + 1 >= MaxDisplayListDepth) {
+                return;
+            }
+
+            ctx.depth++;
+            ctx.nextBlock[ctx.depth] = shiftR(*F5_RDRAM(const uint32_t *, dlistAddr), 0, 24);
+            DisplayList *cursor = reinterpret_cast<DisplayList *>(state->fromRDRAM(dlistAddr)) + 1;
+            const GBI *gbi = state->ext.interpreter->hleGBI;
+            for (uint32_t guard = 0; guard < 0x10000; guard++) {
+                if ((cursor->w0 == 0xB8000000) && (cursor->w1 == 0xFFFFFFFF)) {
+                    break;
+                }
+
+                const uint8_t opCode = cursor->w0 >> 24;
+                if (displayListDumpFile != nullptr) {
+                    fprintf(displayListDumpFile, "  sub %08X %08X\n", cursor->w0, cursor->w1);
+                }
+                GBIFunction func = gbi->map[opCode];
+                if (func != nullptr) {
+                    func(state, &cursor);
+                }
+
+                if (cursor == nullptr) {
+                    break;
+                }
+
+                cursor++;
+            }
+
+            ctx.depth--;
+            *F5_DMEM(uint32_t *, 0x58C) = 0;
+        }
+
+        // DMA into DMEM.
+
+        static void dmaDirect(State *state, uint32_t w0, uint32_t w1) {
+            const uint32_t *src = F5_RDRAM(const uint32_t *, shiftR(w1, 0, 24));
+            uint32_t *dst = F5_DMEM(uint32_t *, shiftR(w0, 8, 12));
+            const uint32_t count = (shiftR(w0, 0, 8) + 1) >> 2;
+            for (uint32_t i = 0; i < count; i++) {
+                dst[i] = src[i];
+            }
+        }
+
+        // Streams data that follows in the display list blocks (set up by SET_DLIST_ADDR).
+        static void dmaSegmented(State *state, uint32_t w0, uint32_t w1) {
+            if (shiftR(w0, 0, 8) == 0) {
+                return;
+            }
+
+            uint32_t *FD4 = F5_DMEM(uint32_t *, 0xFD4);
+            uint32_t *FD8 = F5_DMEM(uint32_t *, 0xFD8);
+            uint32_t *FDC = F5_DMEM(uint32_t *, 0xFDC);
+            int32_t A0 = shiftR(w0, 0, 8);
+            uint32_t A2 = *FDC;
+            int32_t A3 = A0 + 1;
+            int32_t A1 = int32_t(A2) - A3;
+            uint32_t V1 = shiftR(w0, 8, 12);
+            while (A1 < 0) {
+                const uint32_t V0 = *FD4;
+                A3 = A0 - int32_t(A2);
+                memcpy(ctx.dmem.data() + V1, state->RDRAM + shiftR(V0, 0, 24), A2);
+
+                V1 += A2;
+                A0 = A3;
+                w1 = *FD8;
+
+                const uint32_t *src = F5_RDRAM(const uint32_t *, shiftR(w1, 0, 24));
+                *FD8 = *src;
+                *FDC = 0x100;
+                *FD4 = w1 + 0x08;
+
+                A2 = *FDC;
+                A3 = A0 + 1;
+                A1 = int32_t(A2) - A3;
+            }
+
+            const uint32_t V0 = *FD4;
+            const uint32_t T0 = V0 + A3;
+            memcpy(ctx.dmem.data() + V1, state->RDRAM + shiftR(V0, 0, 24), A0 + 1);
+            *FDC = A1;
+            *FD4 = T0;
+        }
+
+        static void setDListAddr(State *state, DisplayList **dl) {
+            const uint32_t w0 = (*dl)->w0;
+            const uint32_t w1 = (*dl)->w1;
+            const uint32_t count = w0 & 0x1FF;
+            const uint32_t *src = F5_RDRAM(const uint32_t *, shiftR(w1, 0, 24));
+            uint32_t *dst = F5_DMEM(uint32_t *, 0xFD4);
+            dst[0] = w1 + 8;
+            dst[1] = *src;
+            dst[2] = count;
+        }
+
+        // Matrices.
+
+        static void loadSTMatrix() {
+            const uint16_t *mtxI = F5_DMEM(const uint16_t *, 0xE40);
+            const uint16_t *mtxF = F5_DMEM(const uint16_t *, 0xE60);
+            for (uint32_t i = 0; i < 16; i++) {
+                ctx.mtxStAdjust[i] = (int32_t(mtxI[i ^ 1]) << 16) | mtxF[i ^ 1];
+            }
+        }
+
+        // GLideN64 negates y after transforming the vertices of this microcode (gSPLoadSWVertexData). Doing it in the
+        // matrix keeps the picture upright and the triangle winding (and with it culling) as on the hardware.
+        static void flipY(hlslpp::float4x4 &m) {
+            static const bool noFlip = getenv("INDY64_NOFLIP") != nullptr;
+            if (noFlip) {
+                return;
+            }
+
+            for (int r = 0; r < 4; r++) {
+                m[r][1] = -float(m[r][1]);
+            }
+        }
+
+        static void loadVtxGenMatrix(State *state, uint32_t address) {
+            const FixedMatrix *fixedMatrix = reinterpret_cast<const FixedMatrix *>(state->fromRDRAM(address & 0xFFFFF8));
+            ctx.mtxVtxGen = fixedMatrix->toMatrix4x4();
+            flipY(ctx.mtxVtxGen);
+        }
+
+        // Vertices.
+
+        // Loads positions into vertex slots [first, first + count). Color and texture coordinates are set per triangle.
+        static void loadVertices(State *state, const SWVertex *src, uint32_t first, uint32_t count) {
+            if ((count == 0) || ((first + count) > RSP_MAX_VERTICES)) {
+                return;
+            }
+
+            RSP::Vertex vertices[RSP_MAX_VERTICES] = {};
+            for (uint32_t i = 0; i < count; i++) {
+                memcpy(&vertices[i], &src[i], sizeof(SWVertex));
+                vertices[i].color.r = vertices[i].color.g = vertices[i].color.b = vertices[i].color.a = 0xFF;
+            }
+
+            state->rsp->setVertexHost(vertices, count, first);
+        }
+
+        // Loads only the vertices whose bit is set (GLideN64: gSPSWVertex with verticesToProcess).
+        static void loadVerticesMasked(State *state, const SWVertex *src, const bool *process, uint32_t count) {
+            uint32_t runStart = 0;
+            bool inRun = false;
+            for (uint32_t i = 0; i <= count; i++) {
+                const bool take = (i < count) && process[i];
+                if (take && !inRun) {
+                    runStart = i;
+                    inRun = true;
+                }
+                else if (!take && inRun) {
+                    loadVertices(state, src + runStart, runStart, i - runStart);
+                    inRun = false;
+                }
+            }
+        }
+
+        // Vertex indices are halfwords at DMEM, positions are 6-byte records in RDRAM, offset by DMEM 0x128.
+        static const SWVertex *loadVtxIndexed(State *state, uint32_t w0, uint32_t w1) {
+            const uint32_t count = shiftR(w1, 24, 8);
+            const uint32_t dmemAddr = shiftR(w0, 8, 12);
+            const uint16_t *dmemData = F5_DMEM(const uint16_t *, dmemAddr);
+            const uint32_t baseAddr = *F5_DMEM(const uint32_t *, 0x154);
+            ctx.vertexScratch.resize(count);
+            uint32_t *res = reinterpret_cast<uint32_t *>(ctx.vertexScratch.data());
+            const uint16_t *v0Data = F5_DMEM(const uint16_t *, 0x128);
+            const uint16_t X0 = v0Data[0x0 ^ 1];
+            const uint16_t Y0 = v0Data[0x1 ^ 1];
+            const uint16_t Z0 = v0Data[0x2 ^ 1];
+            for (uint32_t i = 0; i < count; i++) {
+                const uint32_t rdramAddr = dmemData[i ^ 1] * 6 + baseAddr;
+                const uint16_t *rdramData = F5_RDRAM(const uint16_t *, rdramAddr & 0x00FFFFF8);
+                const uint32_t shift = (rdramAddr & 7) >> 1;
+                const uint16_t X = rdramData[(shift + 0) ^ 1] + X0;
+                const uint16_t Y = rdramData[(shift + 1) ^ 1] + Y0;
+                const uint16_t Z = rdramData[(shift + 2) ^ 1] + Z0;
+                *res++ = (uint32_t(X) << 16) | Y;
+                *res++ = uint32_t(Z) << 16;
+            }
+
+            return ctx.vertexScratch.data();
+        }
+
+        // Positions in DMEM, offset by DMEM 0x128 when that is non-zero.
+        static const SWVertex *adjustVtx(State *state, uint32_t w0, uint32_t w1) {
+            const uint32_t dmemAddr = shiftR(w0, 8, 12);
+            if (*F5_DMEM(const uint64_t *, 0x128) == 0) {
+                return F5_DMEM(const SWVertex *, dmemAddr);
+            }
+
+            const uint16_t *v0Data = F5_DMEM(const uint16_t *, 0x128);
+            const uint16_t X0 = v0Data[0x0 ^ 1];
+            const uint16_t Y0 = v0Data[0x1 ^ 1];
+            const uint16_t Z0 = v0Data[0x2 ^ 1];
+            const uint32_t count = shiftR(w1, 24, 7);
+            ctx.vertexScratch.resize(count);
+            uint32_t *res = reinterpret_cast<uint32_t *>(ctx.vertexScratch.data());
+            const uint16_t *dmemData = F5_DMEM(const uint16_t *, dmemAddr);
+            for (uint32_t i = 0; i < count; i++) {
+                const uint16_t X = dmemData[0x0 ^ 1] + X0;
+                const uint16_t Y = dmemData[0x1 ^ 1] + Y0;
+                const uint16_t Z = dmemData[0x2 ^ 1] + Z0;
+                *res++ = (uint32_t(X) << 16) | Y;
+                *res++ = uint32_t(Z) << 16;
+                dmemData += 4;
+            }
+
+            return ctx.vertexScratch.data();
+        }
+
+        // Lighting: computes the per-vertex colors at DMEM 0xD40 that the triangle commands pick from.
+
+        static void lightingOverlay1(uint32_t w0, uint32_t w1) {
+            const uint32_t S = ((shiftR(w1, 24, 7) << 2) + 4) & 0xFFF8;
+            memset(ctx.dmem.data() + 0xD40, 0, S);
+
+            uint8_t L = ctx.dmem[0x58B ^ 3];
+            if (L == 0) {
+                *F5_DMEM(uint64_t *, 0x05B0) = 0U;
+                return;
+            }
+
+            uint32_t lightAddr = 0xB10;
+            const uint32_t dataAddr = shiftR(w0, 8, 12);
+            while (true) {
+                uint8_t *dst = ctx.dmem.data() + 0xD40;
+                const uint8_t *data = ctx.dmem.data() + dataAddr;
+                const uint8_t *light = ctx.dmem.data() + lightAddr;
+                if (*light == 0) {
+                    const uint32_t count = S >> 3;
+                    for (uint32_t i = 0; i < count; i++) {
+                        const uint8_t *factor = ctx.dmem.data() + 0x158;
+                        dst[0] = (data[0] * factor[0]) >> 8;
+                        for (uint32_t j = 1; j < 4; j++) {
+                            dst[j] = std::min(((data[j] * factor[j] * light[j]) >> 16) + dst[j], 0xFF);
+                        }
+
+                        factor += 4;
+                        dst += 4;
+                        data += 4;
+                        dst[0] = (data[0] * factor[0]) >> 8;
+                        for (uint32_t j = 1; j < 4; j++) {
+                            dst[j] = std::min(((data[j] * factor[j] * light[j]) >> 16) + dst[j], 0xFF);
+                        }
+
+                        dst += 4;
+                        data += 4;
+                    }
+                }
+                else {
+                    const uint8_t *offsetAddr = ctx.dmem.data() + 0x380;
+                    uint32_t offsetAddrIdx = 0;
+                    uint64_t vtxAddrPos = *F5_DMEM(const uint64_t *, 0x05B0);
+                    const uint32_t factors[2] = { *F5_DMEM(const uint32_t *, 0x158), *F5_DMEM(const uint32_t *, 0x15C) };
+                    const uint32_t count = S >> 3;
+                    for (uint32_t i = 0; i < count; i++) {
+                        uint32_t vtxAddr[2];
+                        switch (vtxAddrPos & 3) {
+                        case 0:
+                            vtxAddr[0] = vtxAddr[1] = lightAddr - 0x10;
+                            break;
+                        case 1:
+                            vtxAddr[0] = lightAddr - 0x08;
+                            vtxAddr[1] = lightAddr - 0x10;
+                            break;
+                        case 2:
+                            vtxAddr[0] = lightAddr - 0x10;
+                            vtxAddr[1] = lightAddr - 0x08;
+                            break;
+                        default:
+                            vtxAddr[0] = vtxAddr[1] = lightAddr - 0x08;
+                            break;
+                        }
+
+                        vtxAddrPos >>= 2;
+                        for (uint32_t j = 0; j < 2; j++) {
+                            const uint32_t *V = F5_DMEM(const uint32_t *, vtxAddr[j]);
+                            const int16_t X1 = int16_t(shiftR(*V, 16, 16));
+                            const int16_t Y1 = int16_t(shiftR(*V, 0, 16));
+                            V++;
+                            const int16_t Z1 = int16_t(shiftR(*V, 16, 16));
+
+                            const uint32_t addr = 0x170 + offsetAddr[offsetAddrIdx ^ 3];
+                            V = F5_DMEM(const uint32_t *, addr & 0x0FFC);
+                            offsetAddrIdx++;
+                            int16_t X = int16_t(shiftR(*V, 16, 16));
+                            int16_t Y = int16_t(shiftR(*V, 0, 16));
+                            V++;
+                            int16_t Z = int16_t(shiftR(*V, 16, 16));
+                            X -= X1;
+                            Y -= Y1;
+                            Z -= Z1;
+
+                            uint64_t T = *F5_DMEM(const uint32_t *, lightAddr + 4);
+                            T = 0xFFFF000000000000ULL | (T << 16);
+                            const uint64_t K = squaredLength(X, Y, Z) * T;
+                            const uint32_t P = uint32_t(K >> 32);
+                            uint32_t P1 = 0;
+                            if ((P & 0xFFFF0000) == 0xFFFF0000) {
+                                P1 = P & 0xFFFF;
+                            }
+
+                            V = F5_DMEM(const uint32_t *, lightAddr);
+                            uint32_t D = (shiftR(*V, 24, 8) * P1) >> 16;
+                            uint32_t E = (shiftR(*V, 16, 8) * P1) >> 16;
+                            uint32_t F = (shiftR(*V, 8, 8) * P1) >> 16;
+                            const uint32_t J = (shiftR(factors[j], 0, 8) * data[0x3 ^ 3]) >> 8;
+                            if (*light == 4) {
+                                *dst++ = uint8_t(J);
+                                *dst = uint8_t(std::min(*dst + F, 0xFFU));
+                                dst++;
+                                *dst = uint8_t(std::min(*dst + E, 0xFFU));
+                                dst++;
+                                *dst = uint8_t(std::min(*dst + D, 0xFFU));
+                                dst++;
+                            }
+                            else {
+                                D += (shiftR(factors[j], 24, 8) * data[0x0 ^ 3]) >> 8;
+                                E += (shiftR(factors[j], 16, 8) * data[0x1 ^ 3]) >> 8;
+                                F += (shiftR(factors[j], 8, 8) * data[0x2 ^ 3]) >> 8;
+                                *dst++ = uint8_t(J);
+                                *dst++ = uint8_t(std::min(F >> 1, 0xFFU));
+                                *dst++ = uint8_t(std::min(E >> 1, 0xFFU));
+                                *dst++ = uint8_t(std::min(D >> 1, 0xFFU));
+                            }
+
+                            data += 4;
+                        }
+                    }
+                }
+
+                --L;
+                if (L == 0) {
+                    *F5_DMEM(uint64_t *, 0x05B0) = 0U;
+                    const uint32_t A = *F5_DMEM(const uint32_t *, 0x5A8);
+                    if (A == 0xFFFFFFFF) {
+                        return;
+                    }
+
+                    uint8_t *dst2 = ctx.dmem.data() + 0xD40;
+                    const uint8_t *factor = ctx.dmem.data() + 0x5A8;
+                    const uint32_t count = S >> 2;
+                    for (uint32_t i = 0; i < count; i++) {
+                        for (uint32_t j = 0; j < 4; j++) {
+                            dst2[j] = (dst2[j] * factor[j]) >> 8;
+                        }
+
+                        dst2 += 4;
+                    }
+
+                    return;
+                }
+
+                lightAddr += 0x18;
+            }
+        }
+
+        static void lightingOverlay2(uint32_t w0, uint32_t w1) {
+            const uint32_t S = ((shiftR(w1, 24, 7) << 2) + 4) & 0xFFF8;
+            memset(ctx.dmem.data() + 0xD40, 0, S + 8);
+
+            uint8_t L = ctx.dmem[0x58B ^ 3];
+            if (L == 0) {
+                *F5_DMEM(uint64_t *, 0x05B0) = 0U;
+                return;
+            }
+
+            uint32_t lightAddr = 0xB10;
+            const uint32_t dataAddr = shiftR(w0, 8, 12);
+            while (true) {
+                uint8_t *dst = ctx.dmem.data() + 0xD40;
+                const uint8_t *data = ctx.dmem.data() + dataAddr;
+                const uint8_t *light = ctx.dmem.data() + lightAddr;
+                if (*light == 0) {
+                    const uint32_t count = S >> 3;
+                    for (uint32_t i = 0; i < count; i++) {
+                        const uint8_t *factor = ctx.dmem.data() + 0x158;
+                        dst[0] = (data[0] * factor[0]) >> 8;
+                        for (uint32_t j = 1; j < 4; j++) {
+                            dst[j] = std::min(((data[j] * factor[j] * light[j]) >> 16) + dst[j], 0xFF);
+                        }
+
+                        factor += 4;
+                        dst += 4;
+                        data += 4;
+                        dst[0] = (data[0] * factor[0]) >> 8;
+                        for (uint32_t j = 1; j < 4; j++) {
+                            dst[j] = std::min(((data[j] * factor[j] * light[j]) >> 16) + dst[j], 0xFF);
+                        }
+
+                        dst += 4;
+                        data += 4;
+                    }
+                }
+                else if (*light == 1) {
+                    uint32_t factor2Addr = 0x380;
+                    uint64_t vtxAddrPos = *F5_DMEM(const uint64_t *, 0x05B0);
+                    const uint32_t factors[2] = { *F5_DMEM(const uint32_t *, 0x158), *F5_DMEM(const uint32_t *, 0x15C) };
+                    const uint32_t count = S >> 3;
+                    for (uint32_t i = 0; i < count; i++) {
+                        uint32_t vtxAddr[2];
+                        switch (vtxAddrPos & 3) {
+                        case 0:
+                            vtxAddr[0] = vtxAddr[1] = lightAddr - 0x10;
+                            break;
+                        case 1:
+                            vtxAddr[0] = lightAddr - 0x08;
+                            vtxAddr[1] = lightAddr - 0x10;
+                            break;
+                        case 2:
+                            vtxAddr[0] = lightAddr - 0x10;
+                            vtxAddr[1] = lightAddr - 0x08;
+                            break;
+                        default:
+                            vtxAddr[0] = vtxAddr[1] = lightAddr - 0x08;
+                            break;
+                        }
+
+                        vtxAddrPos >>= 2;
+                        for (uint32_t j = 0; j < 2; j++) {
+                            uint32_t V = *F5_DMEM(const uint32_t *, vtxAddr[j]);
+                            const int16_t X = int16_t(shiftR(V, 16, 16));
+                            const int16_t Y = int16_t(shiftR(V, 0, 16));
+                            V = *F5_DMEM(const uint32_t *, vtxAddr[j] + 0x04);
+                            const int16_t Z = int16_t(shiftR(V, 16, 16));
+
+                            V = *F5_DMEM(const uint32_t *, factor2Addr);
+                            uint32_t I = uint32_t(((X * int8_t(shiftR(V, 24, 8)) + Y * int8_t(shiftR(V, 16, 8)) + Z * int8_t(shiftR(V, 8, 8))) >> 8) & 0xFFFF);
+                            if ((I & 0x8000) != 0) {
+                                I = 0;
+                            }
+
+                            V = *F5_DMEM(const uint32_t *, lightAddr);
+                            const uint32_t D = (shiftR(V, 24, 8) * I) >> 8;
+                            const uint32_t E = (shiftR(V, 16, 8) * I) >> 8;
+                            const uint32_t F = (shiftR(V, 8, 8) * I) >> 8;
+                            V = factors[j];
+                            const uint32_t K = shiftR(V, 0, 8) * (*data++);
+                            const uint32_t J = shiftR(V, 8, 8) * (*data++);
+                            const uint32_t H = shiftR(V, 16, 8) * (*data++);
+                            const uint32_t G = shiftR(V, 24, 8) * (*data++);
+                            *dst++ = uint8_t(K >> 8);
+                            *dst = uint8_t(std::min(*dst + ((F * J) >> 22), 0xFFU));
+                            dst++;
+                            *dst = uint8_t(std::min(*dst + ((E * H) >> 22), 0xFFU));
+                            dst++;
+                            *dst = uint8_t(std::min(*dst + ((D * G) >> 22), 0xFFU));
+                            dst++;
+                            factor2Addr += 4;
+                        }
+                    }
+                }
+                else {
+                    uint32_t offsetAddr = 0x380;
+                    const uint32_t count = S >> 3;
+                    const uint32_t vtxAddr[2] = { lightAddr - 0x10, lightAddr - 0x10 };
+                    for (uint32_t i = 0; i < count; i++) {
+                        for (uint32_t j = 0; j < 2; j++) {
+                            const uint32_t *V = F5_DMEM(const uint32_t *, vtxAddr[j]);
+                            const int16_t X1 = int16_t(shiftR(*V, 16, 16));
+                            const int16_t Y1 = int16_t(shiftR(*V, 0, 16));
+                            V++;
+                            const int16_t Z1 = int16_t(shiftR(*V, 16, 16));
+
+                            const uint32_t offset = *F5_DMEM(const uint32_t *, offsetAddr + j * 4);
+                            V = F5_DMEM(const uint32_t *, 0x170 + shiftR(offset, 0, 8));
+                            int16_t X = int16_t(shiftR(*V, 16, 16));
+                            int16_t Y = int16_t(shiftR(*V, 0, 16));
+                            V++;
+                            int16_t Z = int16_t(shiftR(*V, 16, 16));
+                            X -= X1;
+                            Y -= Y1;
+                            Z -= Z1;
+
+                            uint64_t T = *F5_DMEM(const uint32_t *, lightAddr + 4);
+                            T = 0xFFFF000000000000ULL | (T << 16);
+                            const uint64_t K = squaredLength(X, Y, Z) * T;
+                            const uint32_t P = uint32_t(K >> 32);
+                            uint32_t P1 = 0;
+                            if ((P & 0xFFFF0000) == 0xFFFF0000) {
+                                P1 = P & 0xFFFF;
+                            }
+
+                            const uint8_t *factor = ctx.dmem.data() + 0x158 + j * 4;
+                            dst[0] = (data[0] * factor[0]) >> 8;
+                            const uint8_t *lightBytes = ctx.dmem.data() + lightAddr;
+                            for (uint32_t k = 1; k < 4; k++) {
+                                dst[k] = uint8_t(std::min(((((lightBytes[k] * P1) >> 16) * data[k] * factor[k] + 0x8000) >> 16) + dst[k], 0xFFU));
+                            }
+
+                            dst += 4;
+                            data += 4;
+                        }
+
+                        offsetAddr += 8;
+                    }
+                }
+
+                --L;
+                if (L == 0) {
+                    *F5_DMEM(uint64_t *, 0x05B0) = 0U;
+                    return;
+                }
+
+                lightAddr += 0x18;
+            }
+        }
+
+        static void lightingBasic(uint32_t w0, uint32_t w1) {
+            int32_t count = shiftR(w1, 24, 7);
+            const uint8_t *factor = ctx.dmem.data() + 0x158;
+            const uint8_t *data = ctx.dmem.data() + shiftR(w0, 8, 12);
+            uint8_t *dst = ctx.dmem.data() + 0xD40;
+            while (count > 0) {
+                for (uint32_t j = 0; j < 8; j++) {
+                    dst[j] = (data[j] * factor[j]) >> 8;
+                }
+
+                dst += 8;
+                data += 8;
+                for (uint32_t j = 0; j < 8; j++) {
+                    dst[j] = (data[j] * factor[j]) >> 8;
+                }
+
+                dst += 8;
+                data += 8;
+                count -= 4;
+            }
+        }
+
+        // Expands RGB565 colors in place to RGBA8888.
+        static void rebuildAndAdjustColors(uint32_t w0, uint32_t w1) {
+            const uint32_t addr = shiftR(w0, 8, 12);
+            const uint32_t count = std::min(shiftR(w1, 24, 8), (0x588 - addr) >> 2);
+            const uint16_t *data = F5_DMEM(const uint16_t *, addr);
+            std::vector<uint32_t> res(count);
+            for (uint32_t i = 0; i < count; i++) {
+                const uint16_t V = data[i ^ 1];
+                const uint32_t R = (V >> 8) & 0xF8;
+                const uint32_t G = (V & 0x7E0) >> 3;
+                const uint32_t B = (V & 0x1F) << 3;
+                res[i] = (R << 24) | (G << 16) | (B << 8) | 0xFF;
+            }
+
+            memcpy(ctx.dmem.data() + addr, res.data(), count << 2);
+        }
+
+        static void moveMem(State *state, DisplayList **dl) {
+            const uint32_t w0 = (*dl)->w0;
+            const uint32_t w1 = (*dl)->w1;
+            if (shiftR(w1, 0, 24) != 0) {
+                dmaDirect(state, w0, w1);
+            }
+            else {
+                dmaSegmented(state, w0, w1);
+            }
+
+            switch (w0 & 0x00F00000) {
+            case 0x00000000:
+                switch (w0) {
+                case 0x0101300F:
+                    {
+                        static uint32_t last[4] = {};
+                        static uint32_t dumped = 0;
+                        const uint32_t *v = F5_RDRAM(const uint32_t *, shiftR(w1, 0, 24));
+                        if ((memcmp(v, last, sizeof(last)) != 0) && (dumped++ < 40)) {
+                            memcpy(last, v, sizeof(last));
+                            fprintf(stderr, "[f5indi] viewport %08X: %08X %08X %08X %08X | 14C %08X list %u\n", w1, v[0], v[1], v[2], v[3], *F5_DMEM(const uint32_t *, 0x14C), traceLists);
+                        }
+                    }
+                    state->rsp->setViewport(w1);
+                    {
+                        // The RSP clips at the near plane but not at the far plane, a host GPU would drop everything
+                        // beyond it (the sky). Map z/w from [-1, 3] instead of [-1, 1] to the depth range: the near
+                        // plane stays where it is and the depth order is kept.
+                        interop::RSPViewport &viewport = state->rsp->viewportStack[state->rsp->viewportStackSize - 1];
+                        const float nearZ = float(viewport.translate.z) - float(viewport.scale.z);
+                        viewport.scale.z = float(viewport.scale.z) * 0.5f;
+                        viewport.translate.z = nearZ + float(viewport.scale.z);
+                    }
+                    break;
+                case 0x0105C03F:
+                    if (((traceLists % 300) == 0) || (getenv("INDY64_MTX_LIST") && (traceLists == uint32_t(atoi(getenv("INDY64_MTX_LIST")))))) {
+                        static uint32_t dumped = 0;
+                        if (dumped++ < 400) {
+                            const uint32_t *m = F5_RDRAM(const uint32_t *, shiftR(w1, 0, 24));
+                            fprintf(stderr, "[f5indi] force matrix %08X:", w1);
+                            for (uint32_t i = 0; i < 16; i++) {
+                                fprintf(stderr, " %08X", m[i]);
+                            }
+                            const uint32_t *v0 = F5_DMEM(const uint32_t *, 0x128);
+                            fprintf(stderr, " | dmem128 %08X %08X dmem154 %08X\n", v0[0], v0[1], *F5_DMEM(const uint32_t *, 0x154));
+                        }
+                    }
+                    state->rsp->forceMatrix(w1);
+                    flipY(state->rsp->modelViewProjMatrix);
+                    {
+                        // Bring-up aid: INDY64_CAMLOG logs the first matrix of every 30th list (camera tracking).
+                        static const bool camLog = getenv("INDY64_CAMLOG") != nullptr;
+                        static uint32_t lastLoggedList = 0;
+                        if (camLog && ((traceLists % 30) == 0) && (traceLists != lastLoggedList)) {
+                            lastLoggedList = traceLists;
+                            const hlslpp::float4x4 &m = state->rsp->modelViewProjMatrix;
+                            fprintf(stderr, "[cam] list %u", traceLists);
+                            for (int r = 0; r < 4; r++) {
+                                fprintf(stderr, " | %.4f %.4f %.4f %.4f", float(m[r][0]), float(m[r][1]), float(m[r][2]), float(m[r][3]));
+                            }
+                            fprintf(stderr, "\n");
+                        }
+                    }
+                    break;
+                case 0x010E403F:
+                    if (getenv("INDY64_MTX_LIST") && (traceLists == uint32_t(atoi(getenv("INDY64_MTX_LIST"))))) {
+                        const uint32_t *m = F5_RDRAM(const uint32_t *, shiftR(w1, 0, 24));
+                        fprintf(stderr, "[f5indi] vtxgen matrix %08X:", w1);
+                        for (uint32_t i = 0; i < 16; i++) {
+                            fprintf(stderr, " %08X", m[i]);
+                        }
+                        fprintf(stderr, "\n");
+                    }
+                    loadVtxGenMatrix(state, shiftR(w1, 0, 24));
+                    loadSTMatrix();
+                    break;
+                }
+
+                break;
+            case 0x00100000: {
+                const uint32_t n = shiftR(w1, 24, 7);
+                loadVertices(state, adjustVtx(state, w0, w1), 0, n);
+                break;
+            }
+            case 0x00300000:
+                // Number of lights.
+                ctx.dmem[0x058B ^ 3] = uint8_t(w1 >> 24);
+                break;
+            case 0x00500000: {
+                const uint32_t n = shiftR(w1, 24, 7);
+                loadVertices(state, loadVtxIndexed(state, w0, w1), 0, n);
+                break;
+            }
+            default:
+                if (shiftR(w0, 8, 12) == 0x480) {
+                    const uint32_t F = (w0 >> 22);
+                    if ((F & 2) != 0) {
+                        rebuildAndAdjustColors(w0, w1);
+                    }
+
+                    const uint8_t L = ctx.dmem[0x58B ^ 3];
+                    const uint32_t C = shiftR(w1, 24, 8) | L;
+                    if ((C & 0x80) == 0) {
+                        if ((F & 1) != 0) {
+                            lightingOverlay1(w0, w1);
+                        }
+                        else {
+                            lightingOverlay2(w0, w1);
+                        }
+                    }
+                    else {
+                        lightingBasic(w0, w1);
+                    }
+                }
+
+                break;
+            }
+        }
+
+        // Triangles.
+
+        // Environment-mapped texture coordinates from the vertex positions (GLideN64: F5INDI_CalcST).
+        static void calcST(const uint32_t *p, uint32_t *st, uint32_t num) {
+            const int16_t *subs = F5_DMEM(const int16_t *, 0x0F0);
+            const uint16_t *muls = F5_DMEM(const uint16_t *, 0x0EC);
+            const int32_t *mtx = ctx.mtxStAdjust;
+            for (uint32_t i = 0; i < num; i++) {
+                const uint32_t idx = shiftR(p[i + 4], 0, 8);
+                const int16_t *coords = F5_DMEM(const int16_t *, 0x170 + idx);
+                const int16_t X = coords[0x0 ^ 1];
+                const int16_t Y = coords[0x1 ^ 1];
+                const int16_t Z = coords[0x2 ^ 1];
+                int32_t X1 = X * mtx[0 + 4 * 0] + Y * mtx[0 + 4 * 1] + Z * mtx[0 + 4 * 2] + mtx[0 + 4 * 3];
+                int32_t Y1 = X * mtx[1 + 4 * 0] + Y * mtx[1 + 4 * 1] + Z * mtx[1 + 4 * 2] + mtx[1 + 4 * 3];
+                int32_t Z1 = X * mtx[2 + 4 * 0] + Y * mtx[2 + 4 * 1] + Z * mtx[2 + 4 * 2] + mtx[2 + 4 * 3];
+                X1 -= int32_t(uint32_t(uint16_t(subs[0x0 ^ 1])) << 16);
+                Y1 -= int32_t(uint32_t(uint16_t(subs[0x1 ^ 1])) << 16);
+                Z1 -= int32_t(uint32_t(uint16_t(subs[0x2 ^ 1])) << 16);
+                const uint64_t X2 = uint64_t(int64_t(X1));
+                const uint64_t X2_2 = (X2 * X2) >> 16;
+                const uint64_t Y2 = uint64_t(int64_t(Y1));
+                const uint64_t Y2_2 = (Y2 * Y2) >> 16;
+                const uint64_t Z2 = uint64_t(int64_t(Z1));
+                const uint64_t Z2_2 = (Z2 * Z2) >> 16;
+                const uint64_t R = X2_2 + Y2_2 + Z2_2;
+                uint32_t R1 = uint32_t(R);
+                if (R > 0x0000FFFFFFFFULL) {
+                    R1 = 0x7FFF0000 | (R & 0xFFFF);
+                }
+
+                uint32_t D = uint32_t(sqrt(double(R1)));
+                D = (D == 0) ? 0xFFFFFFFF : (0xFFFFFFFF / (D * 0x300));
+                const uint32_t V = uint32_t((D * X2) >> 16);
+                const uint32_t W = uint32_t((D * Y2) >> 16);
+                const uint32_t S = (V * muls[0x0 ^ 1]) >> 16;
+                const uint32_t T = (W * muls[0x1 ^ 1]) >> 16;
+                st[i] = (S << 16) | (T & 0xFFFF);
+            }
+        }
