+        // Geometry generators (command 0x05).
+
+        static void genVertices(State *state, uint32_t w0, uint32_t w1) {
+            RSP &rsp = *state->rsp;
+            const SWVertex *vertex = F5_DMEM(const SWVertex *, 0x170);
+            bool process[32] = {};
+            uint32_t A = (w0 & 0x0000FFFF) | (w1 & 0xFFFF0000);
+            uint32_t B = 1;
+            uint32_t count = 0;
+            while ((A != 0) && (count < 32)) {
+                const uint32_t C = A & B;
+                process[count++] = (C != 0);
+                if (C != 0) {
+                    A ^= C;
+                }
+
+                B <<= 1;
+            }
+
+            // These vertices use their own matrix instead of the current one.
+            const hlslpp::float4x4 savedMatrix = rsp.modelViewProjMatrix;
+            rsp.modelViewProjMatrix = ctx.mtxVtxGen;
+            rsp.modelViewProjInserted = true;
+            rsp.modelViewProjChanged = false;
+            loadVerticesMasked(state, vertex, process, count);
+            rsp.modelViewProjMatrix = savedMatrix;
+            rsp.modelViewProjInserted = true;
+            rsp.modelViewProjChanged = false;
+        }
+
+        // Particle system: animates particle positions in DMEM and writes them back to RDRAM.
+        static void genParticlesVertices(State *state, const uint32_t *p) {
+            static const uint32_t dpcClock0 = uint32_t(time(nullptr));
+            *F5_DMEM(uint64_t *, 0xC10) = *F5_RDRAM(const uint64_t *, shiftR(p[3], 0, 24));
+            const uint32_t L = *F5_DMEM(const uint32_t *, 0xC10);
+            if (L == 0) {
+                return;
+            }
+
+            uint32_t U = L;
+            memcpy(ctx.dmem.data() + 0x170, state->RDRAM + shiftR(p[2], 0, 24), 256);
+            const uint32_t corrector = shiftR(p[0], 0, 16);
+            const uint32_t M = shiftR(p[5], 0, 16);
+            uint32_t vtxAddr = 0x170;
+            uint32_t lightAddr = 0xB00;
+            uint32_t factorAddr = 0x380;
+            uint32_t colorAddr = 0x480;
+            uint32_t count = 0;
+            uint32_t Q = 0;
+            while ((U != 0) && (count < 32)) {
+                SWVertex *vertex = F5_DMEM(SWVertex *, vtxAddr);
+                uint16_t *light = F5_DMEM(uint16_t *, lightAddr);
+                uint16_t F = uint16_t((((uint32_t(light[0x0 ^ 1]) << 12) + light[0x1 ^ 1] * corrector) << 4) >> 16);
+                bool endCycle = false;
+                if ((M & 0x2000) == 0) {
+                    int16_t F1;
+                    do {
+                        F = uint16_t((((uint32_t(light[0x0 ^ 1]) << 12) + light[0x1 ^ 1] * corrector) << 4) >> 16);
+                        F1 = int16_t(F + 0xF000);
+                        if (F1 < 0) {
+                            light[0x0 ^ 1] = F;
+                            if ((M & 0x40) != 0) {
+                                vertex->flag = uint16_t((((F >> 4) & 0xFC) << 8) | (vertex->flag & 0xFF));
+                            }
+
+                            if ((M & 0x20) != 0) {
+                                vertex->flag = uint16_t(((F >> 4) & 0xFC) | (vertex->flag & 0xFF00));
+                            }
+                        }
+                        else {
+                            light[0x0 ^ 1] = 0U;
+                            if ((M & 0x4000) != 0) {
+                                const uint32_t dpcClock = uint32_t(time(nullptr)) - dpcClock0;
+                                const uint32_t *V = F5_DMEM(const uint32_t *, 0xC18);
+                                vertex->x = int16_t((dpcClock & shiftR(V[0], 16, 16)) + shiftR(V[2], 16, 16));
+                                vertex->y = int16_t(((dpcClock >> 3) & shiftR(V[0], 0, 16)) + shiftR(V[2], 0, 16));
+                                vertex->z = int16_t(((dpcClock >> 6) & shiftR(V[1], 16, 16)) + shiftR(V[3], 16, 16));
+                                vertex->flag &= uint16_t(shiftR(V[1], 0, 16));
+                            }
+                            else {
+                                Q |= 1U << count;
+                                endCycle = true;
+                                break;
+                            }
+                        }
+                    } while (F1 >= 0);
+                }
+
+                if (!endCycle) {
+                    uint32_t X = shiftL(uint32_t(vertex->x), 12, 16) + uint32_t(int16_t(shiftR(p[4], 16, 16)) * int32_t(corrector));
+                    uint32_t Y = shiftL(uint32_t(vertex->y), 12, 16) + uint32_t(int16_t(shiftR(p[4], 0, 16)) * int32_t(corrector));
+                    uint32_t Z = shiftL(uint32_t(vertex->z), 12, 16) + uint32_t(int16_t(shiftR(p[5], 16, 16)) * int32_t(corrector));
+                    if ((M & 0x0380) != 0) {
+                        uint32_t offset = factorAddr - 0x380;
+                        if ((M & 0x0200) == 0) {
+                            if ((M & 0x080) != 0) {
+                                offset = shiftR(F, 4, 8) & 0xF8;
+                            }
+                            else {
+                                const uint32_t pp = *F5_DMEM(const uint32_t *, lightAddr + 4);
+                                offset = shiftR(pp, 24, 8) << 3;
+                            }
+                        }
+
+                        const uint32_t *factor = F5_DMEM(const uint32_t *, 0x380 + offset);
+                        X += uint32_t(int16_t(shiftR(factor[0], 16, 16)) * int32_t(corrector));
+                        Y += uint32_t(int16_t(shiftR(factor[0], 0, 16)) * int32_t(corrector));
+                        Z += uint32_t(int16_t(shiftR(factor[1], 16, 16)) * int32_t(corrector));
+                    }
+
+                    if ((M & 0x1C00) != 0) {
+                        uint32_t offset = colorAddr - 0x480;
+                        if ((M & 0x1000) == 0) {
+                            if ((M & 0x0400) != 0) {
+                                offset = shiftR(F, 4, 8) & 0xF8;
+                            }
+                            else {
+                                const uint32_t pp = *F5_DMEM(const uint32_t *, lightAddr + 4);
+                                offset = shiftR(pp, 16, 8) << 3;
+                            }
+                        }
+
+                        const uint32_t *factor = F5_DMEM(const uint32_t *, 0x480 + offset);
+                        X += uint32_t(int16_t(shiftR(factor[0], 16, 16)) * int32_t(corrector));
+                        Y += uint32_t(int16_t(shiftR(factor[0], 0, 16)) * int32_t(corrector));
+                        Z += uint32_t(int16_t(shiftR(factor[1], 16, 16)) * int32_t(corrector));
+                    }
+
+                    X = (X << 4) >> 16;
+                    Y = (Y << 4) >> 16;
+                    Z = (Z << 4) >> 16;
+                    vertex->x = int16_t(X);
+                    vertex->y = int16_t(Y);
+                    vertex->z = int16_t(Z);
+                    if ((M & 0x0008) != 0) {
+                        const uint32_t *V = F5_DMEM(const uint32_t *, 0xC00);
+                        const int16_t minX = int16_t(shiftR(V[0], 16, 16)), sizeX = int16_t(shiftR(V[2], 16, 16));
+                        const int16_t minY = int16_t(shiftR(V[0], 0, 16)), sizeY = int16_t(shiftR(V[2], 0, 16));
+                        const int16_t minZ = int16_t(shiftR(V[1], 16, 16)), sizeZ = int16_t(shiftR(V[3], 16, 16));
+                        if (vertex->x < minX) vertex->x += sizeX;
+                        if (vertex->x > minX + sizeX) vertex->x -= sizeX;
+                        if (vertex->y < minY) vertex->y += sizeY;
+                        if (vertex->y > minY + sizeY) vertex->y -= sizeY;
+                        if (vertex->z < minZ) vertex->z += sizeZ;
+                        if (vertex->z > minZ + sizeZ) vertex->z -= sizeZ;
+                    }
+                }
+
+                vtxAddr += 8;
+                lightAddr += 8;
+                factorAddr += 8;
+                colorAddr += 8;
+                U >>= 1;
+                count++;
+            }
+
+            memcpy(state->RDRAM + shiftR(p[2], 0, 24), ctx.dmem.data() + 0x170, 256);
+            if ((M & 0x04) == 0) {
+                *F5_RDRAM(uint32_t *, shiftR(p[3], 0, 24)) = L & (~Q);
+                memcpy(state->RDRAM + shiftR(p[1], 8, 24), ctx.dmem.data() + 0xB00, count * 8);
+            }
+        }
+
+        static uint32_t texrectGenVertexMask(State *state, uint32_t mask, uint32_t limAddr, uint32_t vtxAddr) {
+            const uint32_t *V = F5_DMEM(const uint32_t *, limAddr);
+            const int16_t XL = int16_t(shiftR(V[0], 16, 16));
+            const int16_t YL = int16_t(shiftR(V[0], 0, 16));
+            const int16_t ZL = int16_t(shiftR(V[1], 16, 16));
+            const int16_t XR = int16_t(shiftR(V[2], 16, 16));
+            const int16_t YR = int16_t(shiftR(V[2], 0, 16));
+            const int16_t ZR = int16_t(shiftR(V[3], 16, 16));
+            uint32_t S = 0xFFFFFFFE;
+            const SWVertex *vertex = F5_RDRAM(const SWVertex *, vtxAddr);
+            for (uint32_t i = 0; i < 0x20; i++) {
+                if ((vertex[i].x > XL) && (vertex[i].x < XR) && (vertex[i].y > YL) && (vertex[i].y < YR) && (vertex[i].z > ZL) && (vertex[i].z < ZR)) {
+                    mask &= S;
+                }
+
+                S = (S << 1) | 1;
+            }
+
+            return mask;
+        }
+
+        // Billboards: one screen-space textured rectangle per particle vertex (GLideN64: F5INDI_TexrectGen).
+        static void texrectGen(State *state, const uint32_t *p) {
+            RSP &rsp = *state->rsp;
+            const uint32_t vp = *F5_DMEM(const uint32_t *, 0x130);
+            const uint32_t vpx = shiftR(vp, 17, 15);
+            const uint32_t vpy = shiftR(vp, 1, 15);
+            const uint32_t maxX = (shiftR(p[0], 0, 16) * vpx) >> 16;
+            const uint32_t maxY = (shiftR(p[1], 16, 16) * vpy) >> 16;
+            const uint64_t MX = (p[4] & 0xFFFF0000) | shiftR(p[5], 16, 16);
+            const uint64_t xScale = MX * shiftR(p[7], 16, 16) * vpx;
+            const uint64_t MY = shiftL(p[4], 16, 16) | shiftR(p[5], 0, 16);
+            const uint64_t yScale = MY * shiftR(p[7], 0, 16) * vpy;
+            const uint32_t mp = *F5_DMEM(const uint32_t *, 0x5C8);
+            const uint64_t Q = (p[6] & 0xFFFF0000) | shiftR(mp, 16, 16);
+            const uint64_t R = shiftL(p[6], 16, 16) | shiftR(mp, 0, 16);
+            const uint32_t colorScale = p[3];
+
+            int32_t count = shiftR(p[0], 16, 8);
+            uint32_t vtxAddr = shiftR(p[2], 0, 24);
+            for (; count > 0; --count) {
+                const SWVertex *vertex = F5_RDRAM(const SWVertex *, vtxAddr);
+                loadVertices(state, vertex, 0, 0x20);
+                uint32_t K = p[8];
+                uint32_t B = p[9] & 0xFF;
+                uint32_t limAddr = 0xC28;
+                while (B != 0) {
+                    K = texrectGenVertexMask(state, K, limAddr, vtxAddr);
+                    B--;
+                    limAddr += 0x10;
+                }
+
+                const Workload &workload = currentWorkload(state);
+                for (uint32_t i = 0; i < 0x20; i++) {
+                    const uint32_t D = K & 1;
+                    K >>= 1;
+                    if (D == 0) {
+                        continue;
+                    }
+
+                    const uint32_t globalIndex = rsp.indices[i];
+                    const hlslpp::float4 &clipPos = workload.drawData.posTransformed[globalIndex];
+                    if (clipFlags(clipPos) != 0) {
+                        continue;
+                    }
+
+                    const hlslpp::float3 &screen = workload.drawData.posScreen[globalIndex];
+                    const float screenX = screen.x;
+                    const float screenY = screen.y;
+                    const uint32_t w_i = std::max(1U, uint32_t(float(clipPos.w)));
+                    const uint32_t inv_w = 0xFFFFFFFF / w_i;
+
+                    const uint32_t val = *F5_DMEM(const uint32_t *, 0x480 + shiftR(vertex[i].flag, 8, 8));
+                    const uint32_t A = shiftR(val, 16, 16);
+                    const uint32_t C = shiftR(val, 0, 16);
+
+                    uint64_t offsetXI = (xScale * inv_w) >> 32;
+                    offsetXI = (offsetXI * A) >> 32;
+                    offsetXI = std::clamp<uint64_t>(offsetXI, 4, std::max<uint64_t>(4, maxX));
+                    const float offsetXF = float(offsetXI) / 4.0f;
+                    const float ulx = screenX - offsetXF;
+                    const int32_t G = (screenX - offsetXF > 0.0f) ? 0 : int32_t(screenX - offsetXF);
+                    const float lrx = std::max(0.0f, screenX + offsetXF);
+                    if (lrx - ulx <= 0.0f) {
+                        continue;
+                    }
+
+                    uint64_t offsetYI = (yScale * inv_w) >> 32;
+                    offsetYI = (offsetYI * C) >> 32;
+                    offsetYI = std::clamp<uint64_t>(offsetYI, 4, std::max<uint64_t>(4, maxY));
+                    const float offsetYF = float(offsetYI) / 4.0f;
+                    const float uly = screenY - offsetYF;
+                    const int32_t H = (screenY - offsetYF > 0.0f) ? 0 : int32_t(screenY - offsetYF);
+                    const float lry = std::max(0.0f, screenY + offsetYF);
+                    if (lry - uly <= 0.0f) {
+                        continue;
+                    }
+
+                    const uint64_t Q1 = Q * 0x40 / offsetXI;
+                    const uint16_t dsdxI = uint16_t(Q1 >> 16);
+                    const uint64_t R1 = R * 0x40 / offsetYI;
+                    const uint16_t dtdyI = uint16_t(R1 >> 16);
+
+                    const uint64_t U = std::min<uint64_t>(Q1 * 0x40U, 0x7FFFFFFFU);
+                    const uint16_t U1 = uint16_t(((0 - U) * uint64_t(int64_t(G))) >> 16);
+                    const int16_t S = int16_t((U1 - 2) * 8);
+                    const uint64_t V = std::min<uint64_t>(R1 * 0x40U, 0x7FFFFFFFU);
+                    const uint16_t V1 = uint16_t(((0 - V) * uint64_t(int64_t(H))) >> 16);
+                    const int16_t T = int16_t((V1 - 2) * 8);
+
+                    // TODO: Verify the prim depth scale against RT64's depth convention once it renders.
+                    const float screenZ = std::clamp(float(screen.z), 0.0f, 1.0f);
+                    state->rdp->setPrimDepth(uint16_t(screenZ * 0x7FFF), 0);
+
+                    const uint32_t primColor = *F5_DMEM(const uint32_t *, 0x380 + shiftR(vertex[i].flag, 0, 8));
+                    const uint32_t r = (shiftR(primColor, 24, 8) * shiftR(colorScale, 24, 8)) >> 8;
+                    const uint32_t g = (shiftR(primColor, 16, 8) * shiftR(colorScale, 16, 8)) >> 8;
+                    const uint32_t b = (shiftR(primColor, 8, 8) * shiftR(colorScale, 8, 8)) >> 8;
+                    const uint32_t a = (shiftR(primColor, 0, 8) * shiftR(colorScale, 0, 8)) >> 8;
+                    // TODO: Keep the current LOD fraction and minimum instead of resetting them.
+                    state->rdp->setPrimColor(0, 0, (r << 24) | (g << 16) | (b << 8) | a);
+                    state->rdp->drawTexRect(int32_t(ulx * 4.0f), int32_t(uly * 4.0f), int32_t(lrx * 4.0f), int32_t(lry * 4.0f), 0, S, T, int16_t(dsdxI), int16_t(dtdyI), false);
+                }
+
+                vtxAddr += 0x100;
+            }
+        }
+
+        static void geometryGen(State *state, DisplayList **dl) {
+            const uint32_t w0 = (*dl)->w0;
+            const uint32_t w1 = (*dl)->w1;
+            const uint32_t mode = shiftR(w1, 0, 8);
+            switch (mode) {
+            case 0x18:
+                genVertices(state, w0, w1);
+                break;
+            case 0x24:
+                doSubDList(state);
+                texrectGen(state, params(*dl));
+                *dl = *dl + 4;
+                break;
+            case 0x27:
+                genParticlesVertices(state, params(*dl));
+                *dl = *dl + 2;
+                break;
+            default:
+                // 0x09, 0x0C, 0x0F, 0x15 and 0x4F are only used by Battle for Naboo.
+                assert(false && "Unimplemented F5INDI geometry generator mode.");
+                break;
+            }
+        }
+
+        // Rectangles.
+
+        static void texrect(State *state, DisplayList **dl) {
+            traceRects++;
+            doSubDList(state);
+
+            const uint32_t w0 = (*dl)->w0;
+            const uint32_t w1 = (*dl)->w1;
+            const int32_t ulx = shiftR(w1, 12, 12);
+            const int32_t uly = shiftR(w1, 0, 12);
+            const int32_t lrx = shiftR(w0, 12, 12);
+            const int32_t lry = shiftR(w0, 0, 12);
+            const uint8_t tile = uint8_t(shiftR(w1, 24, 3));
+
+            // No RDPHALF commands in this microcode: the second half follows directly (w0 = S/T, w1 = DsDx/DtDy).
+            *dl = *dl + 1;
+            const int16_t uls = int16_t(shiftR((*dl)->w0, 16, 16));
+            const int16_t ult = int16_t(shiftR((*dl)->w0, 0, 16));
+            const int16_t dsdx = int16_t(shiftR((*dl)->w1, 16, 16));
+            const int16_t dtdy = int16_t(shiftR((*dl)->w1, 0, 16));
+            state->rdp->drawTexRect(ulx, uly, lrx, lry, tile, uls, ult, dsdx, dtdy, false);
+        }
+
+        // State.
+
+        static void moveWord(State *state, DisplayList **dl) {
+            const uint32_t destAddr = shiftR((*dl)->w0, 0, 12);
+            const uint32_t w1 = (*dl)->w1;
+            *F5_DMEM(uint32_t *, destAddr) = w1;
+            switch (destAddr) {
+            case G_MWO_CLIP_RNX:
+            case G_MWO_CLIP_RNY:
+            case G_MWO_CLIP_RPX:
+            case G_MWO_CLIP_RPY:
+                state->rsp->setClipRatioEdge(uint8_t((destAddr - G_MWO_CLIP_RNX) / 8), int16_t(w1 & 0xFFFFU));
+                break;
+            case 0x14C:
+                state->rsp->setPerspNorm(w1);
+                break;
+            case 0x160:
+            case 0x164: {
+                // Fog multiplier (0x160) and offset (0x164) as s15.16. GLideN64 uses them as the fraction of full fog
+                // (fog = z/w * mul + offset); RT64 divides by 255 instead, so scale by 256 like F3D's s16 values.
+                static uint32_t logged = 0;
+                if (logged++ < 8) {
+                    fprintf(stderr, "[f5indi] fog %s %08X (%g)\n", (destAddr == 0x160) ? "mul" : "offset", w1, double(int32_t(w1)) / 65536.0);
+                }
+
+                RSP &rsp = *state->rsp;
+                const float value = float(int32_t(w1)) / 256.0f;
+                if (destAddr == 0x160) {
+                    rsp.fog.mul = value;
+                }
+                else {
+                    rsp.fog.offset = value;
+                }
+
+                rsp.fogChanged = true;
+                break;
+            }
+            default:
+                // 0x158/0x15C/0x5B0/0x5B4: color factors for MOVEMEM lighting, 0x58C: sub display list address.
+                break;
+            }
+        }
+
+        static void setOtherMode(State *state, DisplayList **dl) {
+            const uint32_t w0 = (*dl)->w0;
+            const uint32_t w1 = (*dl)->w1;
+            uint32_t mask = uint32_t(int32_t(0x80000000) / (1 << shiftR(w0, 0, 5)));
+            mask >>= shiftR(w0, 8, 5);
+            RSP &rsp = *state->rsp;
+            const interop::OtherMode &otherMode = rsp.otherModeStack[rsp.otherModeStackSize - 1];
+            const uint32_t A0 = shiftR(w0, 16, 3);
+            if (A0 == 0) {
+                rsp.setOtherMode((otherMode.H & (~mask)) | w1, otherMode.L);
+            }
+            else if (A0 == 4) {
+                rsp.setOtherMode(otherMode.H, (otherMode.L & (~mask)) | w1);
+            }
+        }
+
+        static void setOtherModeConditional(State *state, DisplayList **dl) {
+            if (shiftR((*dl)->w0, 23, 1) != *F5_DMEM(const uint32_t *, 0x11C)) {
+                return;
+            }
+
+            setOtherMode(state, dl);
+        }
+
+        static void setGeometryMode(State *state, DisplayList **dl) {
+            state->rsp->setGeometryMode((*dl)->w1);
+        }
+
+        static void clearGeometryMode(State *state, DisplayList **dl) {
+            // The operand is the mask of bits to keep.
+            state->rsp->clearGeometryMode(~(*dl)->w1);
+        }
+
+        static void texture(State *state, DisplayList **dl) {
+            const uint32_t w0 = (*dl)->w0;
+            const uint32_t w1 = (*dl)->w1;
+            state->rsp->setTexture(uint8_t(shiftR(w0, 8, 3)), uint8_t(shiftR(w0, 11, 3)), uint8_t(shiftR(w0, 0, 8)), uint16_t(shiftR(w1, 16, 16)), uint16_t(shiftR(w1, 0, 16)));
+            *F5_DMEM(uint32_t *, 0x148) = w0;
+
+            // Bit 1 of the operand mirrors into the geometry mode.
+            RSP &rsp = *state->rsp;
+            const uint32_t geometryMode = rsp.geometryModeStack[rsp.geometryModeStackSize - 1];
+            if (((geometryMode ^ w0) & 2) != 0) {
+                if (w0 & 2) {
+                    rsp.setGeometryMode(2);
+                }
+                else {
+                    rsp.clearGeometryMode(2);
+                }
+            }
+        }
+
+        static void noOp(State *state, DisplayList **dl) {
+        }
+
+        static void reset(State *state) {
+            // DMEM persists across tasks like in GLideN64 (the HLE never reloads ucode data): the game sets some
+            // state only once, e.g. the indexed vertex base at 0x154. startDisplayList clears the per-list fields.
+            ctx.depth = 0;
+
+            // This microcode only ever forces the full MVP. RT64 still multiplies it with the inverse of the current
+            // projection on the GPU side, which is a zero matrix after RSP::reset, so use identities instead.
+            RSP &rsp = *state->rsp;
+            const int p = rsp.projectionMatrixStackSize - 1;
+            if (float(rsp.projMatrixStack[p][3][3]) == 0.0f && float(rsp.projMatrixStack[p][0][0]) == 0.0f) {
+                rsp.viewMatrixStack[p] = hlslpp::float4x4::identity();
+                rsp.projMatrixStack[p] = hlslpp::float4x4::identity();
+                rsp.viewProjMatrixStack[p] = hlslpp::float4x4::identity();
+                rsp.invViewProjMatrixStack[p] = hlslpp::float4x4::identity();
+                rsp.projectionMatrixInversed = true;
+                rsp.projectionMatrixChanged = true;
+            }
+
+            state->rsp->setLookAtVectors(hlslpp::float3(0.0f, 1.0f, 0.0f), hlslpp::float3(1.0f, 0.0f, 0.0f));
+        }
+
+        void setup(GBI *gbi) {
+            gbi->constants = {
+                { F3DENUM::G_MTX_MODELVIEW, 0x00 },
+                { F3DENUM::G_MTX_PROJECTION, 0x01 },
+                { F3DENUM::G_MTX_MUL, 0x00 },
+                { F3DENUM::G_MTX_LOAD, 0x02 },
+                { F3DENUM::G_MTX_NOPUSH, 0x00 },
+                { F3DENUM::G_MTX_PUSH, 0x04 },
+                { F3DENUM::G_TEXTURE_ENABLE, 0x00000002 },
+                // GLideN64: G_SHADING_SMOOTH = G_SHADE for this microcode.
+                { F3DENUM::G_SHADING_SMOOTH, 0x00000004 },
+                { F3DENUM::G_CULL_FRONT, 0x00001000 },
+                { F3DENUM::G_CULL_BACK, 0x00002000 },
+                { F3DENUM::G_CULL_BOTH, 0x00003000 }
+            };
+
+            gbi->map[F5INDI_SPNOOP] = &noOp;
+            gbi->map[F5INDI_MOVEMEM] = &moveMem;
+            gbi->map[F5INDI_SET_DLIST_ADDR] = &setDListAddr;
+            gbi->map[F5INDI_GEOMETRY_GEN] = &geometryGen;
+            gbi->map[F5INDI_DL] = &runDl;
+            gbi->map[F5INDI_BRANCHDL] = &branchDl;
+            gbi->map[F5INDI_TRI2] = &tri;
+            gbi->map[F5INDI_JUMPDL] = &jumpDl;
+            gbi->map[F5INDI_SETGEOMETRYMODE] = &setGeometryMode;
+            gbi->map[F5INDI_CLEARGEOMETRYMODE] = &clearGeometryMode;
+            gbi->map[F5INDI_ENDDL] = &endDl;
+            gbi->map[F5INDI_SETOTHERMODE_C] = &setOtherModeConditional;
+            gbi->map[F5INDI_SETOTHERMODE] = &setOtherMode;
+            gbi->map[F5INDI_TEXTURE] = &texture;
+            gbi->map[F5INDI_MOVEWORD] = &moveWord;
+            gbi->map[F5INDI_TRI1] = &tri;
+            gbi->map[F5INDI_TEXRECT] = &texrect;
+
+            gbi->resetFromTask = &reset;
+            gbi->startDisplayList = &startDisplayList;
+        }
+
+#       undef F5_DMEM
+#       undef F5_RDRAM
+    }
+};
