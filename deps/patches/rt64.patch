+                        const int32_t t = int32_t(int16_t(st & 0xFFFF)) * 2;
+                        st = (uint32_t(uint16_t(std::clamp(s, -32768, 32767))) << 16) | uint16_t(std::clamp(t, -32768, 32767));
+                    }
+
+                    rsp.modifyVertex(uint16_t(vert[i]), G_MWO_POINT_ST, st);
+                }
+            }
