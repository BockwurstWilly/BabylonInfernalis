+                // modifyVertex turns fog off for the vertex (F3DEX2 MODIFYVTX semantics). Here only the color comes
+                // from the triangle; as in GLideN64 the fog factor still comes from the depth when G_FOG is set.
+                // Without this the corner alpha (usually 0xFF) became the fog factor: whole levels in fog color.
+                {
+                    Workload &workload = state->ext.workloadQueue->workloads[state->ext.workloadQueue->writeCursor];
+                    workload.drawData.fogIndices[rsp.indices[vert[i]]] = rsp.curFogIndex;
